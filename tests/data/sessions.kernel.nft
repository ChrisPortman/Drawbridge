table inet drawbridge {
	chain client_filter {
		ct mark != 0x00000000 jump session_flows
		ct state established,related accept
		ip daddr 192.168.50.1 tcp dport 8443 counter accept
		ip saddr 192.168.50.0/24 ip daddr 10.0.1.0/24 tcp dport 443 counter accept
		ip saddr 192.168.50.0/24 ip daddr 10.0.1.0/24 tcp dport 8000-8100 counter accept
		ip saddr 192.168.50.0/24 ip daddr 10.0.0.53 udp dport 53 counter accept
		ip6 saddr fd00:50::/64 ip6 daddr fd00:1::/64 meta l4proto 58 counter accept
		jump sessions
		counter drop
	}

	chain session_flows {
		ip saddr 192.168.60.7 ct mark 0x00000001 return
		ip saddr 192.168.60.8 ct mark 0x00000003 return
		counter drop
	}

	chain sessions {
		ip saddr 192.168.60.7 jump session_1
		ip saddr 192.168.60.8 jump session_3
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname "wg0" jump client_filter
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "wg0" jump client_filter
	}

	chain session_1 {
		ip saddr 192.168.60.7 ip daddr 10.0.1.0/24 tcp dport 22 ct mark set 0x00000001 counter accept
		ip saddr 192.168.60.7 ip daddr 10.0.1.0/24 tcp dport 443 ct mark set 0x00000001 counter accept
	}

	chain session_3 {
		ip saddr 192.168.60.8 ip daddr 10.0.1.0/24 tcp dport 22 ct mark set 0x00000003 counter accept
		ip saddr 192.168.60.8 ip daddr 10.0.1.0/24 tcp dport 443 ct mark set 0x00000003 counter accept
	}
}
