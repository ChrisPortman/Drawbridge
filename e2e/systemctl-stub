#!/bin/sh
# Stand-in for `systemctl --user` in the e2e client container, which has no systemd. It runs the
# drawbridge-client unit's ExecStart with a notify socket, as a Type=notify unit, and reports its
# state the way `drawbridge client login` and `logout` read it: activating until the service sends
# READY=1, then active; inactive after a clean exit, failed otherwise. Every call is logged to
# ~/systemctl.log, the service's output goes to $XDG_RUNTIME_DIR/stub/service.log.
set -eu
dir="${XDG_RUNTIME_DIR:?}/stub"
unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/drawbridge-client.service"
mkdir -p "$dir"
echo "systemctl $*" >>"$HOME/systemctl.log"
[ "${1:-}" = --user ] && shift

state() { cat "$dir/state" 2>/dev/null || echo "inactive success"; }
set_state() { echo "$1" >"$dir/state.new" && mv "$dir/state.new" "$dir/state"; }
running() { case "$(state)" in active* | activating*) return 0 ;; *) return 1 ;; esac; }

supervise() { # runs the service, tracking its state until it exits
    cmd=$(sed -n 's/^ExecStart=//p' "$unit")
    eval "set -- $cmd"
    NOTIFY_SOCKET="$dir/notify.sock" "$@" >>"$dir/service.log" 2>&1 &
    pid=$!
    echo "$pid" >"$dir/pid"
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$(state)" = "activating success" ] && grep -qx 'READY=1' "$dir/notify"; then
            set_state "active success"
        fi
        sleep 0.2
    done
    status=0
    wait "$pid" || status=$?
    if [ "$status" = 0 ]; then set_state "inactive success"; else set_state "failed exit-code"; fi
    echo "exited $status" >>"$dir/service.log"
    kill "$(cat "$dir/socat.pid")" 2>/dev/null || true
    rm -f "$dir/pid"
}

case "${1:-}" in
start)
    running && exit 0
    set_state "activating success"
    rm -f "$dir/notify.sock"
    : >"$dir/notify"
    # Detached from our output, so a caller reading it isn't kept waiting.
    socat -u UNIX-RECV:"$dir/notify.sock" OPEN:"$dir/notify",creat,append </dev/null >/dev/null 2>&1 &
    echo $! >"$dir/socat.pid"
    while [ ! -S "$dir/notify.sock" ]; do sleep 0.05; done
    # `exec` rather than redirecting the call: dash would keep copies of our output open in it.
    (
        exec </dev/null >/dev/null 2>&1
        supervise
    ) &
    if [ "${2:-}" != --no-block ]; then
        while [ "$(state)" = "activating success" ]; do sleep 0.2; done
        [ "$(state)" = "active success" ]
    fi
    ;;
stop)
    pid=$(cat "$dir/pid" 2>/dev/null) || exit 0
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 75); do running || break; sleep 0.2; done
    ;;
show)
    read -r active result <<EOF
$(state)
EOF
    echo "ActiveState=$active"
    echo "Result=$result"
    echo "StatusText=$(sed -n 's/^STATUS=//p' "$dir/notify" 2>/dev/null | tail -n1)"
    ;;
reset-failed)
    case "$(state)" in failed*) set_state "inactive success" ;; esac
    ;;
daemon-reload | import-environment | set-environment) ;;
*)
    echo "systemctl-stub: unsupported: $*" >&2
    exit 1
    ;;
esac
